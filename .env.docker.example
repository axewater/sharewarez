# Docker-specific environment configuration for SharewareZ
# Copy this file to .env when using Docker and customize the values

# Database connection - NOTE: Use 'db' as hostname for Docker Compose setup
# ── The application's database role ────────────────────────────────────────
# The app does NOT connect as the postgres superuser. It connects as this role,
# which owns only the sharewarez database and can reach nothing else in the
# cluster (a superuser can read every other database's password hashes and run
# shell commands on the database host via COPY..TO PROGRAM).
#
# docker/initdb/01-create-app-role.sh creates this role automatically the first
# time the database volume is initialised, using exactly these two values.
# DATABASE_URL is then built from them by docker-compose.yml, so the password
# is written once. YOU MUST CHANGE APP_DB_PASSWORD - the container refuses to
# initialise while it is still the example value.
APP_DB_USER=sharewarez_app
APP_DB_PASSWORD=change-me-to-a-long-random-string

# Optional: set DATABASE_URL explicitly to override the line built above
# (existing installs created before the init script existed do this).
#DATABASE_URL=postgresql://sharewarez_app:your-db-password@db:5432/sharewarez

# Test database (only needed if running unit tests)
# Only needed to run the unit tests. The test database and its role are NOT
# created for you - see CLAUDE.md for the two commands.
#TEST_DATABASE_URL=postgresql://sharewareztest_app:your-test-db-password@db:5432/sharewareztest

# Game storage directory - mounted as volume in docker-compose.yml
DATA_FOLDER_WAREZ=/storage

# Base folders (for path resolution)
BASE_FOLDER_WINDOWS=C:\
BASE_FOLDER_POSIX=/

# Flask secret key - CHANGE THIS to a secure random string
# MANDATORY. The app refuses to start while this is unset or still the example
# value - it signs session and "remember me" cookies. Generate one with:
#   python -c 'import secrets; print(secrets.token_urlsafe(64))'
SECRET_KEY=put_your_own_secret_string_here_32617432

# Host path for persistent library storage (cover images, themes, zips)
# This is mounted into the container - use a path relative to docker-compose.yml
LIBRARY_HOST_PATH=./data/library

# Development mode - set to true during theme development
DEV_MODE=false

# Docker-specific PostgreSQL configuration
# These variables are used by the postgres container in docker-compose.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sharewarez

# Additional Docker configuration
# Database host for internal container communication
DATABASE_HOST=db
DATABASE_PORT=5432