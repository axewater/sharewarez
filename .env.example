# The application's database role. Create it once as an administrator; it should
# own this app's tables and be able to reach nothing else on the server:
#   CREATE ROLE sharewarez_app LOGIN PASSWORD 'choose-a-strong-one'
#     NOSUPERUSER NOCREATEDB NOCREATEROLE;
#   REVOKE ALL ON DATABASE sharewarez FROM PUBLIC;
#   GRANT CONNECT ON DATABASE sharewarez TO sharewarez_app;
#   GRANT USAGE, CREATE ON SCHEMA public TO sharewarez_app;
#   -- then: ALTER TABLE <each table> OWNER TO sharewarez_app;
# Do NOT use the 'postgres' superuser here: it holds rights over every database
# on the server and can run shell commands on that host via COPY..TO PROGRAM.
# for docker, replace localhost with db in the database_url
DATABASE_URL=postgresql://sharewarez_app:your-db-password@localhost:5432/sharewarez
# you only need to configure a test database if you plan to run the unit tests
TEST_DATABASE_URL=postgresql://sharewareztest_app:your-test-db-password@localhost:5432/sharewareztest
# point this to the root folder where your gamesare stored
DATA_FOLDER_WAREZ=/
BASE_FOLDER_WINDOWS=C:\
BASE_FOLDER_POSIX=/
SECRET_KEY=put_your_own_secret_string_here_32617432
# this folder is where the app will store static files like cover images and themes
# for non-docker installs, this path is relative to where you run the app
# for docker installs, set LIBRARY_HOST_PATH in .env instead (see .env.docker.example)
UPLOAD_FOLDER=./sharewarez/static/library
# set to true during development to force theme files to be recopied on startup (helpful for theme development)
DEV_MODE=false
# port for the web server to run on (defaults to 5006 if not set)
PORT=5006
# these are only used by the docker setup, you can ignore them if not using docker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sharewarez